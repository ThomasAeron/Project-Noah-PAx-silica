import hashlib
import hmac
import json
import mimetypes
import os
import re
import secrets
import smtplib
import ssl
import time
from email.message import EmailMessage
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit


ROOT = Path(__file__).resolve().parent
ALLOWED_FILES = {
    "account.html",
    "cainta-one-app.txt",
    "download-app.html",
    "favicon.svg",
    "food-express.html",
    "main.html",
    "script.js",
    "style.css",
}
RATE_LIMITS = {}
EMAIL_CODES = {}
OTP_HASH_SECRET = secrets.token_bytes(32)


def load_environment():
    env_file = ROOT / ".env"
    if not env_file.exists():
        return
    for line in env_file.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        os.environ.setdefault(key.strip(), value.strip().strip("\"'"))


def rate_limited(key, limit, window_seconds):
    now = time.monotonic()
    recent = [stamp for stamp in RATE_LIMITS.get(key, []) if now - stamp < window_seconds]
    if len(recent) >= limit:
        RATE_LIMITS[key] = recent
        return True
    recent.append(now)
    RATE_LIMITS[key] = recent
    return False


def send_email_code(recipient, code):
    host = os.environ.get("SMTP_HOST", "").strip()
    username = os.environ.get("SMTP_USER", "").strip()
    password = os.environ.get("SMTP_PASSWORD", "").strip()
    sender = os.environ.get("SMTP_FROM", "").strip() or username
    try:
        port = int(os.environ.get("SMTP_PORT", "465"))
    except ValueError as error:
        raise RuntimeError("Email verification SMTP_PORT must be a number.") from error
    if not host or not username or not password or not sender:
        raise RuntimeError("Email verification is not configured on the server.")

    message = EmailMessage()
    message["Subject"] = "Your Cainta One Express verification code"
    message["From"] = sender
    message["To"] = recipient
    message.set_content(
        f"Your Cainta One Express verification code is {code}.\n\n"
        "It expires in 10 minutes. If you did not request this code, you can ignore this email."
    )

    context = ssl.create_default_context()
    if port == 465:
        with smtplib.SMTP_SSL(host, port, context=context, timeout=15) as smtp:
            smtp.login(username, password)
            smtp.send_message(message)
    else:
        with smtplib.SMTP(host, port, timeout=15) as smtp:
            smtp.ehlo()
            smtp.starttls(context=context)
            smtp.ehlo()
            smtp.login(username, password)
            smtp.send_message(message)


class CaintaOneHandler(BaseHTTPRequestHandler):
    server_version = "CaintaOneLocal/1.0"

    def send_json(self, status, payload):
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def read_json(self):
        try:
            content_length = int(self.headers.get("Content-Length", "0"))
        except ValueError as error:
            raise ValueError("Invalid request body.") from error
        if content_length < 1 or content_length > 4096:
            raise ValueError("Invalid request body size.")
        try:
            payload = json.loads(self.rfile.read(content_length))
        except (json.JSONDecodeError, UnicodeDecodeError) as error:
            raise ValueError("Request must contain valid JSON.") from error
        if not isinstance(payload, dict):
            raise ValueError("Request must contain a JSON object.")
        return payload

    def do_GET(self):
        request_path = urlsplit(self.path).path
        filename = "main.html" if request_path == "/" else request_path.lstrip("/")
        if filename not in ALLOWED_FILES:
            self.send_error(404)
            return
        file_path = ROOT / filename
        try:
            content = file_path.read_bytes()
        except OSError:
            self.send_error(404)
            return
        content_type = mimetypes.guess_type(filename)[0] or "application/octet-stream"
        if content_type.startswith("text/") or content_type in {
            "application/javascript",
            "image/svg+xml",
        }:
            content_type += "; charset=utf-8"
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(content)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(content)

    def do_POST(self):
        route = urlsplit(self.path).path
        if route not in {"/api/otp/send", "/api/otp/check"}:
            self.send_json(404, {"error": "Endpoint not found."})
            return
        try:
            payload = self.read_json()
            email = str(payload.get("email", "")).strip().lower()
            if len(email) > 254 or not re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email):
                raise ValueError("Enter a valid email address.")
            client = self.client_address[0]

            if route == "/api/otp/send":
                if rate_limited(("send-ip", client), 5, 3600):
                    self.send_json(429, {"error": "Too many code requests. Try again later."})
                    return
                if rate_limited(("send-email", email), 3, 600):
                    self.send_json(429, {"error": "A code was sent to this email recently. Try again in a few minutes."})
                    return
                code = f"{secrets.randbelow(1_000_000):06d}"
                send_email_code(email, code)
                digest = hmac.new(
                    OTP_HASH_SECRET,
                    f"{email}:{code}".encode(),
                    hashlib.sha256,
                ).hexdigest()
                EMAIL_CODES[email] = {
                    "digest": digest,
                    "expires_at": time.monotonic() + 600,
                    "attempts": 0,
                }
                self.send_json(200, {"sent": True, "message": "Verification code sent by email."})
                return

            code = str(payload.get("code", "")).strip()
            if not re.fullmatch(r"\d{6}", code):
                raise ValueError("Enter the six-digit code from your email.")
            if rate_limited(("check-ip", client), 10, 900):
                self.send_json(429, {"error": "Too many verification attempts. Try again later."})
                return
            challenge = EMAIL_CODES.get(email)
            if not challenge or challenge["expires_at"] <= time.monotonic():
                EMAIL_CODES.pop(email, None)
                self.send_json(400, {"error": "That code has expired or was not sent. Request a new code."})
                return
            if challenge["attempts"] >= 5:
                EMAIL_CODES.pop(email, None)
                self.send_json(429, {"error": "Too many incorrect codes. Request a new code."})
                return
            digest = hmac.new(
                OTP_HASH_SECRET,
                f"{email}:{code}".encode(),
                hashlib.sha256,
            ).hexdigest()
            if not hmac.compare_digest(challenge["digest"], digest):
                challenge["attempts"] += 1
                self.send_json(400, {"error": "That code is incorrect or expired."})
                return
            EMAIL_CODES.pop(email, None)
            self.send_json(200, {"verified": True, "email": email})
        except ValueError as error:
            self.send_json(400, {"error": str(error)})
        except RuntimeError as error:
            self.send_json(503, {"error": str(error)})
        except (OSError, smtplib.SMTPException, TimeoutError):
            self.send_json(
                502,
                {"error": "Email verification could not send the message. Check SMTP settings and try again."},
            )


def main():
    load_environment()
    port = int(os.environ.get("PORT", "8000"))
    server = ThreadingHTTPServer(("127.0.0.1", port), CaintaOneHandler)
    print(f"Cainta One Express is running at http://127.0.0.1:{port}")
    server.serve_forever()


if __name__ == "__main__":
    main()