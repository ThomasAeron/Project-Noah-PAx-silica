    { category: 'Electronics', match: /earphone|headphone/, photos: ['photo-1505740420928-5e560c06d30e', 'photo-1511707171634-5f897ff02aa9'] },
    { category: 'Electronics', match: /phone|cable|power bank/, photos: ['photo-1511707171634-5f897ff02aa9', 'photo-1519389950473-47ba0277781c'] }
  ];
  const bazaarCategoryPhotos = {
    Clothing: ['photo-1521572163474-6864f9cf17ab', 'photo-1496747611176-843222e1e57c'],
    Shoes: ['photo-1542291026-7eec264c27ff', 'photo-1552346154-21d32810aba3'],
    Bags: ['photo-1553062407-98eeb64c6a62', 'photo-1584917865442-de89df76afd3'],
    Accessories: ['photo-1523275335684-37898b6baf30', 'photo-1511499767150-a48a237f0083'],
    Home: ['photo-1600210492486-724fe5c67fb0', 'photo-1616486338812-3dadae4b4ace'],
    Electronics: ['photo-1511707171634-5f897ff02aa9', 'photo-1505740420928-5e560c06d30e']
  };
  const bazaarProductPhoto = (entry) => {
    const name = entry.name.toLocaleLowerCase();
    const group = bazaarPhotoGroups.find((photoGroup) =>
      photoGroup.category === entry.category && photoGroup.match.test(name)
    );
    const photos = group?.photos || bazaarCategoryPhotos[entry.category];
    if (!photos?.length) return null;

    const stableIndex = [...entry.name].reduce((hash, character) => (hash * 31 + character.charCodeAt(0)) >>> 0, 7);
    return productPhoto(photos[stableIndex % photos.length], `Representative product photo for ${entry.name}`);
  };

  const restaurants = [
    { name: 'Jollibee', area: 'Junction', photo: 'photo-1626082927389-6cd097cdc6ec' },
    { name: "McDonald's", area: 'San Isidro', photo: 'photo-1568901346375-23c9450c58cd' },
