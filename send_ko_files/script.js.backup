    icon: normalizeItemText(name).replace(/ /g, '-'),
    nameWords: normalizeItemText(name).split(' '),
    alsoWords: normalizeItemText(also).split(' ').filter(Boolean),
    categoryWords: normalizeItemText(category).split(' ')
  });

